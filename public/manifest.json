{
  "manifest_version": 3,
  "name": "fayd - forget about your distractions.",
  "version": "1.0.0",
  "description": "Focus timer with time tracking and visualization",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/fayd_logo.png",
      "48": "icons/fayd_logo.png",
      "128": "icons/fayd_logo.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/fayd_logo.png",
    "48": "icons/fayd_logo.png",
    "128": "icons/fayd_logo.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
